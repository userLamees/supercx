# OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# Main LLM used by the agent
LLM_MODEL=gpt-4.1-mini

# Embedding model for the FAQ search index
EMBEDDING_MODEL=text-embedding-3-small

# Folder where the search index is saved
CHROMA_DIR=./chroma_db

# Number of FAQ entries retrieved per question
RAG_TOP_K=4

# Minimum similarity score; weaker matches are ignored
RAG_MIN_SCORE=0.30

# Shared admin key for the staff dashboard (first setup, scripts). Personal accounts are preferred.
SUPPORT_TOKEN=your_support_token_here
ALLOW_SUPPORT_TOKEN=true

# First admin account, created at startup when there is no account yet (must change password at first sign-in)
STAFF_ADMIN_EMAIL=
STAFF_ADMIN_PASSWORD=
STAFF_ADMIN_NAME=مدير النظام
STAFF_SESSION_HOURS=12
# Password for the demo accounts made by `python -m app.seed_demo` (random if empty)
DEMO_STAFF_PASSWORD=

# Speech-to-text model (voice feature, later)
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# Text-to-speech model (voice feature, later)
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Voice used for text-to-speech
OPENAI_TTS_VOICE=coral

# Email (SMTP) and WhatsApp (Twilio): verification codes and reply notifications.
# Leave empty for demo mode (codes simulated, notifications kept in the demo outbox).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Tell the visitor when the team replies
NOTIFY_ON_REPLY=true
# Public address used in the notification link, e.g. https://supercx.replit.app
PUBLIC_BASE_URL=
# Meta-approved WhatsApp template (Twilio Content SID): 1 = case number, 2 = link
TWILIO_REPLY_TEMPLATE_SID=

# Member registry after verification: demo | file | api
MEMBER_REGISTRY=demo
MEMBERS_FILE=
MEMBER_REGISTRY_URL=
MEMBER_REGISTRY_TOKEN=

# Send requests to the association's system: off | demo | webhook | email
CASE_SYNC=demo
CASE_WEBHOOK_URL=
CASE_WEBHOOK_SECRET=
CASE_EMAIL_TO=

# Key for hashing verification codes (set a long random value in production)
OTP_SECRET=
