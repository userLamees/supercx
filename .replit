# SuperCX on Replit. Secrets (DATABASE_URL from Replit Postgres, SUPPORT_TOKEN, OTP_SECRET, ...)
# are listed in docs/REPLIT.md; `python -m app.preflight` checks them.
# --proxy-headers: Replit's proxy forwards the visitor's address and https, so attempt limits
# count each visitor separately and links use https.
run = "uvicorn main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips='*'"
entrypoint = "main.py"
modules = ["python-3.12", "nodejs-20", "web"]

[deployment]
run = ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
build = ["pip", "install", "-r", "requirements.txt"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 8000
externalPort = 80

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uvicorn main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips='*'"
waitForPort = 8000

[userenv]

[userenv.shared]
LLM_MODEL = "gpt-4.1-mini"
RAG_MIN_SCORE = "0.30"
